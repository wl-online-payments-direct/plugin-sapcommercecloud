<widget-definition xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:noNamespaceSchemaLocation="http://www.hybris.com/schema/cockpitng/widget-definition.xsd"
                   id="com.worldline.direct.widgets.order.werorefundreasonwidget">
    <name>Wero Refund Reason Widget</name>
    <description>Wero Refund Reason selection widget built for Worldline plugin</description>
    <defaultTitle>Wero Refund Reason</defaultTitle>
    <author>hybris</author>
    <version>1.0</version>

    <view src="werorefundreasonwidget.zul" />
    <keywords>
        <keyword>OMS</keyword>
    </keywords>

    <sockets>
        <input type="de.hybris.platform.returns.model.ReturnRequestModel" id="inputObject" />
        <output type="java.lang.String" id="confirmrefund" />
    </sockets>

    <controller class="com.worldline.direct.widgets.worldlinewerorefund.WorldlineWeroRefundReasonController" />
</widget-definition>
