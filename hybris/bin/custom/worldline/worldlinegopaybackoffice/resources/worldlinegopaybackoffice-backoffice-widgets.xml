 Copyright (c) 2020 SAP SE or an SAP affiliate company. All rights reserved
--><widgets xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.hybris.com/schema/cockpitng/widgets.xsd">


    <widget-extension widgetId="backofficeMainSlot">
        <widget id="omsWorldlinePartialCapturePopup" widgetDefinitionId="com.worldline.gopay.widgets.order.partialcapturewidget" slotId="cockpitWidgetChildrenInvisible"
                title="Capture Order Payment" template="true">

            <instance-settings socketEventRoutingMode="LAST_USED">
                <create onInit="false" reuseExisting="true">
                    <all-incoming-events/>
                </create>
                <close>
                    <all-outgoing-events/>
                </close>
                <select onInit="false">
                    <all-incoming-events/>
                </select>
            </instance-settings>

            <setting key="widgetStyleClass" type="String"></setting>
            <setting key="__externalLocationPath" type="String">extension://worldlinegopaybackoffice</setting>
            <setting key="widgetStyleAttribute" type="String"></setting>
            <setting key="_width" type="String">1140px</setting>
            <setting key="_height" type="String">650px</setting>
            <virtual-sockets />
        </widget>
    </widget-extension>

    <widget-extension widgetId="backofficeMainSlot">
        <widget id="omsWorldlineWeroRefundReasonPopup" widgetDefinitionId="com.worldline.gopay.widgets.order.werorefundreasonwidget" slotId="cockpitWidgetChildrenInvisible"
                title="Wero Refund Reason" template="true">

            <instance-settings socketEventRoutingMode="LAST_USED">
                <create onInit="false" reuseExisting="true">
                    <all-incoming-events/>
                </create>
                <close>
                    <all-outgoing-events/>
                </close>
                <select onInit="false">
                    <all-incoming-events/>
                </select>
            </instance-settings>

            <setting key="widgetStyleClass" type="String"></setting>
            <setting key="__externalLocationPath" type="String">extension://worldlinegopaybackoffice</setting>
            <setting key="widgetStyleAttribute" type="String"></setting>
            <setting key="_width" type="String">600px</setting>
            <setting key="_height" type="String">400px</setting>
            <virtual-sockets />
        </widget>
    </widget-extension>

    <widget-extension widgetId="backofficeMainSlot">
        <widget id="omsWorldlineCreateReturnRequestPopup"
                widgetDefinitionId="com.worldline.gopay.widgets.returns.worldlinecreatereturnrequest"
                slotId="cockpitWidgetChildrenInvisible" title="Create Return Request" template="true">
            <instance-settings socketEventRoutingMode="LAST_USED">
                <create onInit="false" reuseExisting="true"><all-incoming-events/></create>
                <close><all-outgoing-events/></close>
                <select onInit="false"><all-incoming-events/></select>
            </instance-settings>
            <setting key="widgetStyleClass" type="String"></setting>
            <setting key="__externalLocationPath" type="String">extension://worldlinegopaybackoffice</setting>
            <setting key="widgetStyleAttribute" type="String"></setting>
            <setting key="_width" type="String">1200px</setting>
            <setting key="_height" type="String">700px</setting>
            <virtual-sockets />
        </widget>
    </widget-extension>

    <!-- Action widget connections -->
    <widget-connection sourceWidgetId="STUB_com.worldline.gopay.actions.worldlinemanualpaymentcaptureaction" outputId="capturePaymentContext" targetWidgetId="omsWorldlinePartialCapturePopup" inputId="inputObject"/>
    <widget-connection sourceWidgetId="STUB_com.worldline.gopay.actions.worldlinemanualpaymentrefundaction" outputId="weroRefundContext" targetWidgetId="omsWorldlineWeroRefundReasonPopup" inputId="inputObject"/>
    <widget-connection sourceWidgetId="STUB_com.worldline.gopay.actions.worldlinecreatereturnrequestaction"
                       outputId="createReturnRequestContext"
                       targetWidgetId="omsWorldlineCreateReturnRequestPopup" inputId="inputObject"/>
    <widget-connection sourceWidgetId="STUB_com.worldline.gopay.backoffice.action.featurerequest"
                       outputId="featureRequestWizardContext"
                       targetWidgetId="configurableFlow"
                       inputId="context" />
</widgets>
